---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-CN">
  <title>{{ site.name | xml_escape }}</title>
  <subtitle>{{ site.description | default: site.name | xml_escape }}</subtitle>
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
  <link href="{{ '/atom.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  <author>
    <name>{{ site.author | xml_escape }}</name>
    <uri>{{ '/about/' | absolute_url | xml_escape }}</uri>
  </author>
  {% for post in site.posts limit:20 %}
  <entry>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
    <title>{{ post.title | xml_escape }}</title>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.content | strip_html | normalize_whitespace | truncate: 180 | xml_escape }}</summary>
    <content type="html" xml:base="{{ '/' | absolute_url | xml_escape }}">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
